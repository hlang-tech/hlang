{
  "name": "@hlang-org/compiler",
  "version": "2.2.0",
  "description": "Ahead-of-time compiler for hlang: compiles an IGraph program into a standalone ES module.",
  "keywords": [
    "fbp",
    "fbp-runtime",
    "javascript",
    "flow",
    "creative-coding",
    "fbp-protocol",
    "flow-based-programming",
    "visual-programming-language",
    "flow-based",
    "internal-dsl",
    "hlang",
    "compiler",
    "code-generation",
    "igraph",
    "estree"
  ],
  "homepage": "https://github.com/hlang-tech/hlang/tree/main/packages/compiler#readme",
  "bugs": {
    "url": "https://github.com/hlang-tech/hlang/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlang-tech/hlang.git",
    "directory": "packages/compiler"
  },
  "license": "MIT",
  "author": "hlang-tech",
  "contributors": [
    "Archer <qddegtya@gmail.com>",
    "archersado <archersado@hotmail.com>"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.{ts,mts}\"",
    "lint:pkg": "publint && attw --pack",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf lib coverage"
  },
  "dependencies": {
    "@hlang-org/ir": "workspace:^",
    "astring": "^1.9.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@hlang-org/interpreter": "workspace:^",
    "@hlang-org/runtime": "workspace:^",
    "@types/estree": "^1.0.10",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "publint": "^0.3.21",
    "rxjs": "^7.8.2",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
