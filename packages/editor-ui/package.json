{
  "name": "@hlang-org/editor-ui",
  "version": "0.4.0",
  "description": "Lumen design system for hlang: node, edge, panel, and shell components for a React Flow node editor, built on @hlang-org/editor-react.",
  "keywords": [
    "hlang",
    "lumen",
    "node-editor",
    "design-system",
    "react",
    "react-flow",
    "xyflow"
  ],
  "homepage": "https://github.com/hlang-tech/hlang/tree/main/packages/editor-ui#readme",
  "bugs": {
    "url": "https://github.com/hlang-tech/hlang/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlang-tech/hlang.git",
    "directory": "packages/editor-ui"
  },
  "license": "MIT",
  "author": "hlang-tech",
  "contributors": [
    "Archer <qddegtya@gmail.com>",
    "archersado <archersado@hotmail.com>"
  ],
  "type": "commonjs",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./styles.css": "./lib/styles.css",
    "./tokens.css": "./lib/tokens/tokens.css"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "test": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\"",
    "lint:pkg": "publint && attw --pack",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf lib coverage"
  },
  "dependencies": {
    "@hlang-org/editor-core": "workspace:^",
    "@hlang-org/editor-react": "workspace:^",
    "@hlang-org/interpreter": "workspace:^"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@xyflow/react": "^12.11.1",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^30.1.3",
    "publint": "^0.3.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
