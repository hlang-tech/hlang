{
  "name": "@hlang-org/ir",
  "version": "1.0.1",
  "description": "The hlang intermediate representation: IGraph types, validation, and the execution plan shared by the interpreter and the compiler.",
  "keywords": [
    "hlang",
    "flow-based-programming",
    "fbp",
    "igraph",
    "intermediate-representation",
    "visual-programming-language"
  ],
  "homepage": "https://github.com/hlang-tech/hlang/tree/main/packages/ir#readme",
  "bugs": {
    "url": "https://github.com/hlang-tech/hlang/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlang-tech/hlang.git",
    "directory": "packages/ir"
  },
  "license": "MIT",
  "author": "hlang-tech",
  "contributors": [
    "Archer <qddegtya@gmail.com>",
    "archersado <archersado@hotmail.com>"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:pkg": "publint && attw --pack",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf lib coverage"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@types/jest": "^29.5.12",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "publint": "^0.3.21",
    "ts-jest": "^29.2.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
