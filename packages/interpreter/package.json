{
  "name": "@hlang-org/interpreter",
  "version": "1.0.0",
  "description": "The interpreter for hlang: a first-class, host-agnostic execution engine that evaluates an hlang IGraph program into a live reactive object graph, without code generation.",
  "type": "commonjs",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    }
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "fbp",
    "fbp-runtime",
    "hlang",
    "interpreter",
    "flow-based-programming",
    "visual-programming-language",
    "reactive",
    "rxjs"
  ],
  "homepage": "https://github.com/hlang-tech/hlang#readme",
  "contributors": [
    "archer <qddegtya@gmail.com>",
    "archersado <archersado@hotmail.com>"
  ],
  "license": "MIT",
  "scripts": {
    "build": "./node_modules/.bin/tsup",
    "test": "./node_modules/.bin/jest --coverage",
    "lint": "./node_modules/.bin/eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:pkg": "./node_modules/.bin/publint && ./node_modules/.bin/attw --pack",
    "typecheck": "./node_modules/.bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hlang-org/runtime": "^1.0.5",
    "rxjs": "^6.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@types/jest": "^29.5.12",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "publint": "^0.3.21",
    "ts-jest": "^29.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.62.1"
  }
}
