{
  "name": "@hlang-org/interpreter",
  "version": "1.0.1",
  "description": "In-process interpreter for hlang: evaluates an IGraph program into a live RxJS object graph, with no code generation.",
  "keywords": [
    "hlang",
    "flow-based-programming",
    "fbp",
    "interpreter",
    "igraph",
    "reactive",
    "rxjs",
    "visual-programming-language"
  ],
  "homepage": "https://github.com/hlang-tech/hlang/tree/main/packages/interpreter#readme",
  "bugs": {
    "url": "https://github.com/hlang-tech/hlang/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlang-tech/hlang.git",
    "directory": "packages/interpreter"
  },
  "license": "MIT",
  "author": "hlang-tech",
  "contributors": [
    "Archer <qddegtya@gmail.com>",
    "archersado <archersado@hotmail.com>"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:pkg": "publint && attw --pack",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf lib coverage"
  },
  "dependencies": {
    "@hlang-org/ir": "workspace:^",
    "@hlang-org/runtime": "workspace:^",
    "rxjs": "^6.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@types/jest": "^29.5.12",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "publint": "^0.3.21",
    "ts-jest": "^29.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.62.1"
  }
}
