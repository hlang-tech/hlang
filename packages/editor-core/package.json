{
  "name": "@hlang-org/editor-core",
  "version": "1.0.0",
  "description": "Headless, framework-agnostic core for the hlang visual editor: graph model, commands, history, validation, serialization and execution — zero React, zero pixels.",
  "type": "commonjs",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    }
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "hlang",
    "visual-programming-language",
    "node-editor",
    "headless",
    "flow-based-programming",
    "dependency-injection"
  ],
  "homepage": "https://github.com/hlang-tech/hlang#readme",
  "contributors": [
    "archer <qddegtya@gmail.com>",
    "archersado <archersado@hotmail.com>"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "test": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:pkg": "publint && attw --pack",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf lib coverage"
  },
  "dependencies": {
    "@hlang-org/interpreter": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@hlang-org/runtime": "workspace:^",
    "@types/jest": "^29.5.12",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "publint": "^0.3.21",
    "ts-jest": "^29.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.62.1"
  }
}
