{
  "name": "@hlang-org/editor-core",
  "version": "0.3.0",
  "description": "Headless core of the Lumen editor for hlang: graph model, reversible commands, validation, diagnostics, and IGraph serialization. No React, no DOM.",
  "keywords": [
    "hlang",
    "lumen",
    "node-editor",
    "headless",
    "visual-programming-language",
    "undo-redo",
    "dependency-injection"
  ],
  "homepage": "https://github.com/hlang-tech/hlang/tree/main/packages/editor-core#readme",
  "bugs": {
    "url": "https://github.com/hlang-tech/hlang/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlang-tech/hlang.git",
    "directory": "packages/editor-core"
  },
  "license": "MIT",
  "author": "hlang-tech",
  "contributors": [
    "Archer <qddegtya@gmail.com>",
    "archersado <archersado@hotmail.com>"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:pkg": "publint && attw --pack",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf lib coverage"
  },
  "dependencies": {
    "@hlang-org/interpreter": "workspace:^",
    "@hlang-org/ir": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@hlang-org/runtime": "workspace:^",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.15.0",
    "publint": "^0.3.21",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
