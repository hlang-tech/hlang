{
  "name": "@hlang-org/runtime",
  "version": "2.1.0",
  "description": "A FBP-Inspired language for universal applications.",
  "keywords": [
    "fbp",
    "fbp-runtime",
    "javascript",
    "flow",
    "creative-coding",
    "fbp-protocol",
    "flow-based-programming",
    "visual-programming-language",
    "flow-based",
    "internal-dsl",
    "hlang",
    "dataflow",
    "reactive",
    "rxjs",
    "streams"
  ],
  "homepage": "https://github.com/hlang-tech/hlang/tree/main/packages/runtime#readme",
  "bugs": {
    "url": "https://github.com/hlang-tech/hlang/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlang-tech/hlang.git",
    "directory": "packages/runtime"
  },
  "license": "MIT",
  "author": "hlang-tech",
  "contributors": [
    "Archer <qddegtya@gmail.com>",
    "archersado <archersado@hotmail.com>"
  ],
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "build": "rm -rf lib && tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf lib coverage",
    "lint:pkg": "publint && attw --pack",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "publint": "^0.3.25",
    "rxjs": "^7.8.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "rxjs": "^7.8.2"
  }
}
