{
  "name": "@hlang-org/runtime",
  "version": "1.1.1",
  "description": "A FBP-Inspired language for universal applications.",
  "keywords": [
    "fbp",
    "fbp-runtime",
    "javascript",
    "flow",
    "creative-coding",
    "fbp-protocol",
    "flow-based-programming",
    "visual-programming-language",
    "flow-based",
    "internal-dsl",
    "hlang",
    "dataflow",
    "reactive",
    "rxjs",
    "streams"
  ],
  "homepage": "https://github.com/hlang-tech/hlang/tree/main/packages/runtime#readme",
  "bugs": {
    "url": "https://github.com/hlang-tech/hlang/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlang-tech/hlang.git",
    "directory": "packages/runtime"
  },
  "license": "MIT",
  "author": "hlang-tech",
  "contributors": [
    "Archer <qddegtya@gmail.com>",
    "archersado <archersado@hotmail.com>"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "build": "rm -rf lib && tsc -p tsconfig.json && tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf lib coverage",
    "lint:pkg": "publint && attw --pack",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "rxjs": "^6.6.7",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "publint": "^0.3.25",
    "rxjs": "^6.6.7",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
